{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"files": {
		"includes": [
			"**",
			"!**/node_modules/**/*",
			"!**/.next/**/*",
			"!**/public/**/*",
			"!**/.vscode/**/*"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"useKeyWithClickEvents": "off",
				"useAnchorContent": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "auto"
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "es5"
		}
	}
}
