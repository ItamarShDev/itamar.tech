{
  "compilerOptions": {
    "paths": {
      "app/*": ["./app/*"],
      "actions/*": ["./actions/*"],
      "components": ["./components/index.ts"],
      "components/*": ["./components/*"],
      "context/*": ["./context/*"],
      "images/*": ["./images/*"],
      "layouts/*": ["./layouts/*"],
      "lib/*": ["./lib/*"],
      "mdx-components": ["./mdx-components.tsx"],
      "providers/*": ["./providers/*"],
      "public/*": ["./public/*"],
      "translations": ["./translations/index.ts"],
      "translations/*": ["./translations/*"]
    },
    "types": ["bun", "jest", "node"],
    "jsx": "react-jsx",
    "checkJs": true,
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "e2e"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
